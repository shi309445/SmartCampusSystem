# 复制本文件为 .env 后按实际环境填写；.env 已被 .gitignore 忽略，**不要提交真实密钥**

# ---------------------------------------------------------------- 数据库
# 必须使用 mysql+pymysql:// 前缀；密码含 @ : / # 等字符时要 URL 编码
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/smart_campus_system?charset=utf8mb4
# 排障时打开 SQL 回显（默认 false，避免请求日志被 SQL 淹没）
DB_ECHO=false

# ---------------------------------------------------------------- 鉴权
# 至少 32 位随机字符串（openssl rand -base64 48）
JWT_SECRET_KEY=change-me-to-a-random-string-with-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------------------------------------------------------------- 接口层
# 允许跨域的前端源（JSON 数组）。生产环境改成真实域名，不要用 ["*"]
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 每个学生每分钟最多发多少条聊天消息（0 = 不限流）
CHAT_RATE_LIMIT_PER_MINUTE=20
# 首次启动初始化管理员（不填就跳过，不存在任何默认口令）
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=请改成强密码
# BOOTSTRAP_ADMIN_NAME=系统管理员

# ---------------------------------------------------------------- 模型（DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 意图识别小模型（不配就复用 DEEPSEEK_*）
# INTENT_MODEL=
# INTENT_TIMEOUT=8
# 主模型单次调用超时（秒）与重试次数（429/5xx 由 SDK 指数退避）
# HARNESS_MODEL_TIMEOUT=60
# HARNESS_MODEL_RETRIES=2
# 降级：主模型**运行时**不可用（超时 / 5xx / 断网）时换它把这一轮答完；
# 不配 FALLBACK_MODEL 就不降级（错误照常抛出 → 由异常处理器返回 503）
# HARNESS_MODEL_FALLBACK_ENABLED=1
# FALLBACK_MODEL=deepseek-chat
# FALLBACK_BASE_URL=https://api.deepseek.com
# FALLBACK_API_KEY=（不填就复用 DEEPSEEK_API_KEY）
# FALLBACK_PROVIDER=deepseek

# ---------------------------------------------------------------- 预算 / 失败处理
# HARNESS_BUDGET_ENABLED=1
# HARNESS_TURN_TOKENS=60000
# HARNESS_TURN_SOFT_RATIO=0.8
# HARNESS_DAILY_TOKENS=300000
# HARNESS_DAILY_CALLS=300
# HARNESS_TOOL_TIMEOUT=20
# HARNESS_MAX_CONCURRENT_TOOLS=4
# 工具重试：只对幂等读工具（检索 / 查询类），写操作永不重试
# HARNESS_TOOL_RETRY_ENABLED=1
# HARNESS_TOOL_RETRIES=2
# HARNESS_TOOL_BACKOFF_BASE=0.3
# HARNESS_TOOL_TOTAL_BUDGET=25
# HARNESS_BREAKER_WINDOW=20
# HARNESS_BREAKER_FAILURE_RATIO=0.5
# HARNESS_BREAKER_COOLDOWN=60

# ---------------------------------------------------------------- 安全护栏
# 输出侧 PII 掩码（手机号/身份证/银行卡/邮箱 → 138****0000）
# HARNESS_PII_GUARD=1
# 密钥/连接串脱敏
# HARNESS_SECRET_GUARD=1
# 知识库资料块加边界 + 标记可疑指令（防间接注入）
# HARNESS_DOC_INJECTION_GUARD=1

# ---------------------------------------------------------------- 记忆（Milvus）
# 与 RAG 共用同一个 Milvus；连不上时记忆自动降级为单轮（不影响问答）
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=
# MEMORY_COLLECTION=agent_short_term_memory
# MEMORY_WINDOW_TURNS=8
# MEMORY_WINDOW_MESSAGES=40
# MEMORY_MAX_MESSAGES=400
# MEMORY_EMBED=1
# MEMORY_DISABLED=0

# ---------------------------------------------------------------- 可观测性
# 是否异步写日志（受限环境不支持命名管道时会自动降级为同步写）
# LOG_ENQUEUE=1
# 工具/模型 span 日志（=0 时只留每轮一条回合汇总，日志量大时用）
# HARNESS_SPAN_LOG=1
# LangSmith：打开后会自动上报每条 LangChain/LangGraph run
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=Smart-Campus-System

# ---------------------------------------------------------------- 本地模型路径
# EMBEDDING_MODEL_PATH=./models/BAAI/bge-m3
# RARANKER_MODEL_PATH=./models/BAAI/bge-reranker-v2-m3
